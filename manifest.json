{
  "manifest_version": 3,
  "name": "Quiet Interface",
  "version": "1.0.0",
  "description": "Replace infinite scroll with intentional pauses. Convert notifications into ambient sounds.",
  "permissions": ["storage", "activeTab", "scripting", "alarms"],
  "host_permissions": [
    "https://*.twitter.com/*",
    "https://*.instagram.com/*",
    "https://*.facebook.com/*",
    "https://*.youtube.com/*",
    "https://*.reddit.com/*",
    "https://*.linkedin.com/*",
    "https://*.tiktok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.twitter.com/*",
        "https://*.instagram.com/*",
        "https://*.facebook.com/*",
        "https://*.youtube.com/*",
        "https://*.reddit.com/*",
        "https://*.linkedin.com/*",
        "https://*.tiktok.com/*"
      ],
      "js": ["content.js"],
      "css": ["quiet-styles.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["sounds/*", "quiet-styles.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
